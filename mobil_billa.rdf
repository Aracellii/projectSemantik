        <rdfs:label xml:lang="id">Hino 500 FM 280 TH Trailer Truck</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://hino.id/model/hino-500-fm-280-series/"/>
        <rdfs:seeAlso rdf:resource="https://www.hino.co.id/product-detail/euro4/2/fm-280-th-euro4"/>
        <rdfs:seeAlso rdf:resource="https://www.nist.gov/pml/special-publication-811/nist-guide-si-appendix-b-conversion-factors/nist-guide-si-appendix-b9"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/lenovo/ontologies/2026/9/untitled-ontology-8#Hino500FM280THTrailerTruck"/>
        <owl:annotatedProperty rdf:resource="http://www.semanticweb.org/lenovo/ontologies/2026/9/untitled-ontology-8#HP"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">276.17</owl:annotatedTarget>
        <rdfs:comment xml:lang="id">HASIL KONVERSI: 280 PS x 735.4988 W/PS / 745.6999 W/hp = 276.17 mechanical hp. Daya PS merujuk katalog pabrikan; faktor konversi merujuk NIST.</rdfs:comment>
        <rdfs:seeAlso rdf:resource="https://www.hino.co.id/product-detail/euro4/2/fm-280-th-euro4"/>
        <rdfs:seeAlso rdf:resource="https://www.nist.gov/pml/special-publication-811/nist-guide-si-appendix-b-conversion-factors/nist-guide-si-appendix-b9"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/lenovo/ontologies/2026/9/untitled-ontology-8#Hino500FM280THTrailerTruck"/>
        <owl:annotatedProperty rdf:resource="http://www.semanticweb.org/lenovo/ontologies/2026/9/untitled-ontology-8#harga"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1509000000</owl:annotatedTarget>
        <rdfs:comment xml:lang="id">ESTIMASI DATASET, bukan kutipan harga kendaraan lengkap. harga=1259000000+250000000=1509000000 rupiah. Referensi tractor head FM 280 TH Rp1259000000; trailer Rp250000000 adalah asumsi. Referensi diakses 19 Oktober 2026; basis pajak, wilayah, dan karoseri dapat berbeda.</rdfs:comment>
        <rdfs:seeAlso rdf:resource="https://hino.id/model/hino-500-fm-280-series/"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/lenovo/ontologies/2026/9/untitled-ontology-8#Hino500FM280THTrailerTruck"/>
        <owl:annotatedProperty rdf:resource="http://www.semanticweb.org/lenovo/ontologies/2026/9/untitled-ontology-8#jumlahPenumpang"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</owl:annotatedTarget>
        <rdfs:comment xml:lang="id">ASUMSI contoh unit: 2 orang termasuk pengemudi; bukan kapasitas kursi tersertifikasi yang diverifikasi. Untuk hitung skenario dipakai 75 kg per orang.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/lenovo/ontologies/2026/9/untitled-ontology-8#Hino500FM280THTrailerTruck"/>
        <owl:annotatedProperty rdf:resource="http://www.semanticweb.org/lenovo/ontologies/2026/9/untitled-ontology-8#kapasitasAngkutan"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">23500</owl:annotatedTarget>
        <rdfs:comment xml:lang="id">HASIL HITUNG SKENARIO, bukan rating muatan resmi. Muatan=(((38000-7615-6500-150)//500)*500)=23500 kg. Batas bruto referensi/skenario, massa sasis dan bodi/trailer konfigurasi contoh, serta massa penghuni digunakan untuk latihan; pembatasan beban sumbu dan dokumen pengujian tipe belum diperhitungkan. GVW/GCW tidak diisikan langsung sebagai payload.</rdfs:comment>
        <rdfs:seeAlso rdf:resource="https://www.hino.co.id/product-detail/euro4/2/fm-280-th-euro4"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/lenovo/ontologies/2026/9/untitled-ontology-8#Hino500FM280THTrailerTruck"/>
        <owl:annotatedProperty rdf:resource="http://www.semanticweb.org/lenovo/ontologies/2026/9/untitled-ontology-8#tahunProduksi"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2025</owl:annotatedTarget>
        <rdfs:comment xml:lang="id">ASUMSI tahun contoh unit hipotetis: 2025; bukan tahun produksi unit nyata yang dibuktikan nomor rangka atau dokumen kendaraan.</rdfs:comment>
    </owl:Axiom>
    


